{% extends 'base.html.twig' %}
{% block stylesheets %}
    {% include '/article/style.html.twig' %}
{% endblock %}
{% set userId = 1 %}
{% block title %}Article index{% endblock %}
{% block body %}
    <h1>{{ title }}</h1>
    {% if criteria is defined and not null %}
    <form method="get" action="{{ path('app_article_index') }}" class="search-form">
        <input type="text" name="q" value="{{ criteria.q }}" placeholder="Rechercher un titre...">

        <select name="category">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {{ criteria.category == cat.id ? 'selected' : '' }}>
                    {{ cat.name }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn">Filtrer</button>
        <a href="{{ path('app_article_index') }}" class="btn">Reset</a>
    </form>
    {% endif %}
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Content</th>
                <th>CreatedAt</th>
                <th>Published</th>
                <th>Author</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for article in articles %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.title }}</td>
                <td>{{ article.content }}</td>
                <td>{{ article.createdAt ? article.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ article.published ? 'Yes' : 'No' }}</td>
                <td>{{ article.author.username }}</td>
                <td>
                    <a href="{{ path('app_article_show', {'id': article.id}) }}">show</a>
                    <a href="{{ path('app_article_edit', {'id': article.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="navigation">
        {{ knp_pagination_render(articles) }}
    </div>
    <a href="{{ path('app_article_new') }}">Create new</a>
    <a href="{{ path('app_article_published') }}">See published</a>
    <a href="{{ path('app_article_recent') }}">See recent</a>

{% endblock %}
