{% extends 'base.html.twig' %}

{% block title %}Portfolio - Eliott Maillé{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --primary: #2563eb;
            --dark: #1e293b;
            --light: #f8fafc;
            --text: #334155;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: var(--light);
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }
        header {
            background: var(--dark);
            color: white;
            padding: 2rem 0;
            text-align: center;
        }
        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }
        nav {
            margin-top: 1rem;
        }
        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: 500;
        }
        nav a:hover {
            color: var(--primary);
        }
        section {
            padding: 4rem 0;
        }
        .hero {
            text-align: center;
            background: white;
        }
        .section-title {
            text-align: center;
            margin-bottom: 3rem;
            font-size: 2rem;
            position: relative;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 4px;
            background: var(--primary);
            margin: 10px auto;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }
        .card {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .card h3 {
            margin-top: 0;
            color: var(--dark);
        }
        .badge {
            display: inline-block;
            background: #dbeafe;
            color: var(--primary);
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        footer {
            background: var(--dark);
            color: white;
            text-align: center;
            padding: 2rem 0;
            margin-top: 4rem;
        }
        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--dark);
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            font-family: inherit;
            box-sizing: border-box;
        }
        .btn-submit {
            background: var(--primary);
            color: white;
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: background 0.3s;
        }
        .btn-submit:hover {
            background: #1d4ed8;
        }
        .socials-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .social-item {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: var(--text);
            transition: color 0.3s;
        }
        .social-item:hover {
            color: var(--primary);
        }
        .social-icon {
            width: 40px;
            height: 40px;
            background: #f1f5f9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            font-weight: bold;
            color: var(--primary);
        }
        .placeholder-icon {
            font-size: 0.9rem;
        }
        .contact-info {
            margin-top: 1rem;
            text-align: left;
        }
    </style>
{% endblock %}

{% block body %}

    <header>
        <div class="container">
            <nav>
                <a href={{ path(name= 'app_portfolio') }}>Home</a>
                <a href={{ path(name= 'portfolio_CV') }}>CV</a>
                <a href={{ path(name= 'portfolio_projets') }}>Projets</a>
                <a href={{ path(name= 'portfolio_contact') }}>Contact</a>
            </nav>
        </div>
    </header>

    <section id="contact">
        <div class="container">
            <h2 class="section-title">Contactez-moi</h2>

            <div class="grid">
                <!-- Formulaire de contact -->
                <div class="card">
                    <h3>Envoyez un message</h3>
                    <form action="#" method="POST" class="contact-form">
                        <div class="form-group">
                            <label for="name">Nom</label>
                            <input type="text" id="name" name="name" placeholder="Votre nom" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" placeholder="votre@email.com" required>
                        </div>
                        <div class="form-group">
                            <label for="subject">Sujet</label>
                            <input type="text" id="subject" name="subject" placeholder="Sujet de votre message" required>
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" rows="5" placeholder="Votre message..." required></textarea>
                        </div>
                        <button type="submit" class="btn-submit">Envoyer le message</button>
                    </form>
                </div>

                <!-- Informations et Socials -->
                <div class="card">
                    <h3>Mes coordonnées</h3>
                    <p>Vous avez un projet en tête ou souhaitez simplement échanger ? N'hésitez pas à me contacter.</p>

                    <div class="contact-info">
                        <p><strong>Email :</strong> contact@eliott-maille.fr</p>
                    </div>

                    <h3 style="margin-top: 2rem;">Retrouvez-moi sur</h3>
                    <div class="socials-list">
                        <a href="https://www.linkedin.com/in/eliott-maille/" class="social-item">
                            <div class="social-icon">
                                <!-- L'utilisateur mettra son icône ici -->
                                <span class="placeholder-icon">IN</span>
                            </div>
                            <span>LinkedIn</span>
                        </a>
                        <a href="https://github.com/Mistoruu" class="social-item">
                            <div class="social-icon">
                                <!-- L'utilisateur mettra son icône ici -->
                                <span class="placeholder-icon">GH</span>
                            </div>
                            <span>GitHub</span>
                        </a>
                        <a href="https://github.com/Mistoruu" class="social-item">
                            <div class="social-icon">
                                <!-- L'utilisateur mettra son icône ici -->
                                <span class="placeholder-icon">@</span>
                            </div>
                            <span>maille.eliott@gmail.com</span>
                        </a>
                        <a href="#" class="social-item">
                            <div class="social-icon">
                                <!-- L'utilisateur mettra son icône ici -->
                                <span class="placeholder-icon">📞</span>
                            </div>
                            <span>0769726350</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; {{ "now"|date("Y") }} Eliott Maillé. Tous droits réservés.</p>
        </div>
    </footer>
{% endblock %}
