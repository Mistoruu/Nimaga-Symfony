{% extends 'base.html.twig' %}

{% block title %}Portfolio - Eliott Maillé{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --primary: #2563eb;
            --dark: #1e293b;
            --light: #f8fafc;
            --text: #334155;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: var(--light);
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }
        header {
            background: var(--dark);
            color: white;
            padding: 2rem 0;
            text-align: center;
        }
        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }
        nav {
            margin-top: 1rem;
        }
        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: 500;
        }
        nav a:hover {
            color: var(--primary);
        }
        section {
            padding: 4rem 0;
        }
        .hero {
            text-align: center;
            background: white;
        }
        .section-title {
            text-align: center;
            margin-bottom: 3rem;
            font-size: 2rem;
            position: relative;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 4px;
            background: var(--primary);
            margin: 10px auto;
        }
        .project-section {
            padding: 4rem 0;
        }
        .project-section:nth-child(even) {
            background-color: #ffffff;
        }
        .project-section:nth-child(odd) {
            background-color: #f1f5f9;
        }
        .project-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .project-title {
            margin: 0;
            color: var(--dark);
            font-size: 2rem;
        }
        .project-details {
            background: white;
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }
        .btn-repo {
            display: inline-flex;
            align-items: center;
            background: var(--dark);
            color: white;
            text-decoration: none;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            font-weight: 600;
            transition: background 0.3s;
        }
        .btn-repo:hover {
            background: var(--primary);
        }
        .repo-icon {
            margin-right: 0.5rem;
            font-weight: bold;
        }
        .tech-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
        }
        /* Style manquant pour les badges dans ton CSS d'origine,
           je l'ajoute pour qu'ils soient visibles comme sur ton rendu */
        .badge {
            background: #e2e8f0;
            color: var(--dark);
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: bold;
        }
        footer {
            background: var(--dark);
            color: white;
            text-align: center;
            padding: 2rem 0;
            margin-top: 4rem;
        }
    </style>
{% endblock %}

{% block body %}
    <header>
        <div class="container">
            <h1>Eliott Maillé</h1>
            <p>Développeur Fullstack & Passionné de Symfony</p>
            <nav>
                <a href="{{ path('app_portfolio') }}">Home</a>
                <a href="{{ path('portfolio_CV') }}">CV</a>
                <a href="{{ path('portfolio_projets') }}">Projets</a>
                <a href="{{ path('portfolio_contact') }}">Contact</a>
            </nav>
        </div>
    </header>

    <section id="intro" style="background: white; padding-bottom: 0;">
        <div class="container">
            <h2 class="section-title">Mes Projets</h2>
            <p style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
                Découvrez une sélection de mes travaux les plus significatifs, allant du développement de jeux vidéo à l'automatisation de processus complexes.
            </p>
        </div>
    </section>

    {# Début de la zone dynamique #}
    {% for project in projects %}
        <section class="project-section">
            <div class="container">
                <div class="project-details">
                    <div class="project-header">
                        <div>
                            {% if project.badge %}
                            <span class="badge">{{ project.badge }}</span>
                            {% endif %}
                            <h3 class="project-title">{{ project.title }}</h3>
                        </div>
                        <a href="{{ project.url }}" class="btn-repo" target="_blank">
                            <span class="repo-icon">GH</span> {{ project.url_label }}
                        </a>
                    </div>
                    <div class="project-content">
                        <p>{{ project.description }}</p>

                        {% if project.points is defined and project.points|length > 0 %}
                            <h4>Points clés :</h4>
                            <ul>
                                {% for point in project.points %}
                                    <li>{{ point }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        <div class="tech-list">
                            {% for tech in project.techs %}
                                <span class="badge">{{ tech }}</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {% endfor %}
    {# Fin de la zone dynamique #}

    <section id="contact-cta" style="background: white;">
        <div class="container">
            <div class="project-details" style="text-align: center;">
                <h2 class="section-title">Intéressé par mon travail ?</h2>
                <p>Je suis toujours ouvert à de nouvelles opportunités et collaborations passionnantes.</p>
                <a href="{{ path('portfolio_contact') }}" class="btn-repo" style="background: var(--primary); margin-top: 1rem;">Me contacter</a>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; {{ "now"|date("Y") }} Eliott Maillé. Tous droits réservés.</p>
        </div>
    </footer>
{% endblock %}
