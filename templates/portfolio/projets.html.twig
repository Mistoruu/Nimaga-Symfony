{% extends 'base.html.twig' %}

{% block title %}Portfolio - Eliott Maillé{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --primary: #2563eb;
            --dark: #1e293b;
            --light: #f8fafc;
            --text: #334155;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: var(--light);
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 20px;
        }
        header {
            background: var(--dark);
            color: white;
            padding: 2rem 0;
            text-align: center;
        }
        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }
        nav {
            margin-top: 1rem;
        }
        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: 500;
        }
        nav a:hover {
            color: var(--primary);
        }
        section {
            padding: 4rem 0;
        }
        .hero {
            text-align: center;
            background: white;
        }
        .section-title {
            text-align: center;
            margin-bottom: 3rem;
            font-size: 2rem;
            position: relative;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 4px;
            background: var(--primary);
            margin: 10px auto;
        }
        .project-section {
            padding: 4rem 0;
        }
        .project-section:nth-child(even) {
            background-color: #ffffff;
        }
        .project-section:nth-child(odd) {
            background-color: #f1f5f9;
        }
        .project-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .project-title {
            margin: 0;
            color: var(--dark);
            font-size: 2rem;
        }
        .project-details {
            background: white;
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }
        .btn-repo {
            display: inline-flex;
            align-items: center;
            background: var(--dark);
            color: white;
            text-decoration: none;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            font-weight: 600;
            transition: background 0.3s;
        }
        .btn-repo:hover {
            background: var(--primary);
        }
        .repo-icon {
            margin-right: 0.5rem;
            font-weight: bold;
        }
        .tech-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
        }
        footer {
            background: var(--dark);
            color: white;
            text-align: center;
            padding: 2rem 0;
            margin-top: 4rem;
        }
    </style>
{% endblock %}

{% block body %}
    <header>
        <div class="container">
            <h1>Eliott Maillé</h1>
            <p>Développeur Fullstack & Passionné de Symfony</p>
            <nav>
                <a href={{ path(name= 'app_portfolio') }}>Home</a>
                <a href={{ path(name= 'portfolio_CV') }}>CV</a>
                <a href={{ path(name= 'portfolio_projets') }}>Projets</a>
                <a href={{ path(name= 'portfolio_contact') }}>Contact</a>
            </nav>
        </div>
    </header>

    <section id="intro" style="background: white; padding-bottom: 0;">
        <div class="container">
            <h2 class="section-title">Mes Projets</h2>
            <p style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
                Découvrez une sélection de mes travaux les plus significatifs, allant du développement de jeux vidéo à l'automatisation de processus complexes.
            </p>
        </div>
    </section>

    <!-- Game Jam -->
    <section class="project-section">
        <div class="container">
            <div class="project-details">
                <div class="project-header">
                    <div>
                        <span class="badge">Game Jam</span>
                        <h3 class="project-title">Participation GameJam</h3>
                    </div>
                    <a href="https://mistoru.itch.io/dobrazill" class="btn-repo">
                        <span class="repo-icon">GH</span> Voir la page itch.io
                    </a>
                </div>
                <div class="project-content">
                    <p>
                        Développement intensif d'un jeu vidéo réalisé en un week-end lors d'un événement collaboratif. Ce projet a nécessité une réactivité forte et une excellente gestion des priorités pour transformer une idée conceptuelle en un prototype jouable dans un temps très restreint.
                    </p>
                    <h4>Points clés :</h4>
                    <ul>
                        <li>Conception et implémentation des mécaniques de gameplay principales.</li>
                        <li>Travail d'équipe en flux tendu avec des graphistes et sound designers.</li>
                        <li>Optimisation des ressources pour garantir la fluidité sur navigateur.</li>
                    </ul>
                    <div class="tech-list">
                        <span class="badge">Godot</span>
                        <span class="badge">C#</span>
                        <span class="badge">Game Design</span>
                        <span class="badge">Aseprite</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Python Automation -->
    <section class="project-section">
        <div class="container">
            <div class="project-details">
                <div class="project-header">
                    <div>
                        <span class="badge">Python</span>
                        <h3 class="project-title">Automatisation de tâches</h3>
                    </div>
                    <a href="https://github.com/Mistoruu/Dokkan-EZA-Automation" class="btn-repo">
                        <span class="repo-icon">GH</span> Voir le Repo
                    </a>
                </div>
                <div class="project-content">
                    <p>
                        Conception d'une suite de scripts Python dédiés à l'automatisation de complétion de niveau de type "EZA" sur le jeu Dragon Ball Z: Dokkan Battle ! Ce projet visait à compléter en boucle un niveau pour automatiser la collecte de récompenses dans le jeu.
                    </p>
                    <h4>Points clés :</h4>
                    <ul>
                        <li>Automatisation de la complétion</li>
                        <li>CLI basique</li>
                    </ul>
                    <div class="tech-list">
                        <span class="badge">Python 3</span>
                        <span class="badge">Pyautogui</span>
                        <span class="badge">Automation</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BTS SIO -->
    <section class="project-section">
        <div class="container">
            <div class="project-details">
                <div class="project-header">
                    <div>
                        <span class="badge">BTS SIO</span>
                        <h3 class="project-title">Projet de BTS SIO</h3>
                    </div>
                    <a href="https://github.com/Mistoruu/E6-Leger" class="btn-repo">
                        <span class="repo-icon">GH</span> Voir le Repo
                    </a>
                </div>
                <div class="project-content">
                    <p>
                        Développement d'un site web e-commerce répondant aux exigences d'un cahier des charges professionnel dans le cadre du diplôme BTS SIO. L'application permet de centraliser les données métiers et d'offrir une interface intuitive aux utilisateurs finaux.
                    </p>
                    <h4>Points clés :</h4>
                    <ul>
                        <li>Modélisation rigoureuse de la base de données (UML, Merise).</li>
                        <li>Implémentation d'un système d'authentification et de gestion des droits utilisateurs (RBAC).</li>
                        <li>Génération automatique de rapports et de documents PDF.</li>
                    </ul>
                    <div class="tech-list">
                        <span class="badge">PHP</span>
                        <span class="badge">MySQL</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact-cta" style="background: white;">
        <div class="container">
            <div class="project-details" style="text-align: center;">
                <h2 class="section-title">Intéressé par mon travail ?</h2>
                <p>Je suis toujours ouvert à de nouvelles opportunités et collaborations passionnantes.</p>
                <a href="{{ path('portfolio_contact') }}" class="btn-repo" style="background: var(--primary); margin-top: 1rem;">Me contacter</a>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; {{ "now"|date("Y") }} Eliott Maillé. Tous droits réservés.</p>
        </div>
    </footer>
{% endblock %}
