{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        .article-header {
            background: linear-gradient(135deg, #2c3e50, #3498db);
            color: white;
            padding: 60px 20px;
            text-align: center;
            border-radius: 0 0 50px 50px;
            margin-bottom: 40px;
        }

        .travel-meta {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            padding: 5px 15px;
            border-radius: 20px;
            margin: 10px;
        }

        .article-content {
            max-width: 800px;
            margin: 0 auto;
            line-height: 1.8;
            font-size: 1.2rem;
            color: #444;
        }

        .budget-indicator {
            font-size: 1.5rem;
            color: #f1c40f;
            text-align: center;
            margin: 20px 0;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="article-header">
        <h1>{{ article.titre }}</h1>
        <div class="travel-meta">🌍 {{ article.continent }}</div>
        <div class="travel-meta">📅 {{ article.date|date('M Y') }}</div>
    </div>

    <div class="article-content">
        <div class="budget-indicator">
            Budget : {{ article.budget }}
        </div>

        <p><strong>{{ article.description }}</strong></p>
        <p>{{ article.paragraphe }}</p>

        <div style="margin-top: 50px; text-align: center;">
            <a href="{{ path('blog_list') }}" class="back-link">← Retour aux carnets de voyage</a>
        </div>
    </div>
{% endblock %}
